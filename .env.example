# Required: GitHub organization to monitor.
GITHUB_ORG=my-org

# Set for GHES; omit or use https://github.com for GHEC.
GHES_BASE_URL=https://ghes.example.com

# Configure either an admin PAT or all three GitHub App values.
GITHUB_ADMIN_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional webhook verification secret.
GITHUB_WEBHOOK_SECRET=

# Optional: enables HTTP Basic Auth on the dashboard/API. Both required together.
AUTH_USERNAME=
AUTH_TOKEN=

# Optional runtime settings.
DB_PATH=data/monitor.db
PORT=8080
WORKFLOW_POLL_INTERVAL=5m
RUNNER_POLL_INTERVAL=10m
WORKFLOW_SPOT_CHECK_WINDOW=24h
STALE_RUN_RECONCILE_AFTER=3h
# Log one line per outgoing GitHub API request (method, path, status,
# remaining rate-limit budget). Verbose; use to find rate-limit spenders.
GITHUB_API_ACCESS_LOG=false
